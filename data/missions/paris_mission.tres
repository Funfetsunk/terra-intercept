[sub_resource type="Resource" id="Resource_hnmob"]
script = ExtResource("3_krpuu")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_lbgbr")
text = "Siphon's down and the Seine is flowing again. Nice flying."

[sub_resource type="Resource" id="Resource_a4x06"]
script = ExtResource("3_krpuu")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_25oe8")
text = "Whatever they wanted that water for, they wanted a lot of it. Stay sharp."

[sub_resource type="Resource" id="Resource_bbx6a"]
script = ExtResource("3_krpuu")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_ntwru")
text = "Paris. They've planted something in the Seine, and it's drinking the river dry."

[sub_resource type="Resource" id="Resource_66wn1"]
script = ExtResource("3_krpuu")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_25oe8")
text = "New fighters in the mix -- they'll hit you from the sides, and from behind. Watch the edges for warning blips."

[sub_resource type="Resource" id="Resource_wb17x"]
script = ExtResource("3_krpuu")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_ntwru")
text = "Find the siphon and shut it down."

