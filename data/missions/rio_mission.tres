[sub_resource type="Resource" id="Resource_4uvry"]
script = ExtResource("3_h6f8p")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_ld12c")
text = "Sugarloaf's clear. Rio's breathing again."

[sub_resource type="Resource" id="Resource_74ub5"]
script = ExtResource("3_h6f8p")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_x0i3h")
text = "That's the last of their ground operations. Next stop: orbit."

[sub_resource type="Resource" id="Resource_0n6hi"]
script = ExtResource("3_h6f8p")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_qxp6t")
text = "Rio. They're coming up out of the sea along the whole coastline."

[sub_resource type="Resource" id="Resource_87mww"]
script = ExtResource("3_h6f8p")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_x0i3h")
text = "Watch the waterline -- when you see splashes, a wave is about to surface. New drones too: some dive straight at you, some split apart when you hit them."

[sub_resource type="Resource" id="Resource_sgqsn"]
script = ExtResource("3_h6f8p")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_qxp6t")
text = "They've dug into Sugarloaf Mountain. Take it back."

