[sub_resource type="Resource" id="Resource_l2rkn"]
script = ExtResource("3_4atwv")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_b5y5e")
text = "Signal confirmed -- every portal they have just went dark. Their colonies are cut off. It's over."

[sub_resource type="Resource" id="Resource_qluqy"]
script = ExtResource("3_4atwv")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_02g6e")
text = "And there you are. Four ships, coming out of the sky over home."

[sub_resource type="Resource" id="Resource_eie0s"]
script = ExtResource("3_4atwv")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_b5y5e")
text = "Welcome back, pilots. Earth owes you everything."

[sub_resource type="Resource" id="Resource_4b8ko"]
script = ExtResource("3_4atwv")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_02g6e")
text = "This is it. Their homeworld. Look at it -- they mined it down to the bone."

[sub_resource type="Resource" id="Resource_ei1po"]
script = ExtResource("3_4atwv")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_xig8x")
text = "Get through their air defences and into the foundry. The Gate Core is at its heart. Deliver the frequency there and every portal they own collapses."

[sub_resource type="Resource" id="Resource_7iwtu"]
script = ExtResource("3_4atwv")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_02g6e")
text = "When it blows, the portal home starts closing. Don't stop. Don't look back. Fly."

