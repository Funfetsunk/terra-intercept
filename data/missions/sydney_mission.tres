[sub_resource type="Resource" id="Resource_6he8m"]
script = ExtResource("3_r2ovy")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_gytp4")
text = "The leviathan's on the bottom of the harbour where it belongs."

[sub_resource type="Resource" id="Resource_r1yr3"]
script = ExtResource("3_r2ovy")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_1a60w")
text = "One more push and we're at their front door."

[sub_resource type="Resource" id="Resource_2d0vf"]
script = ExtResource("3_r2ovy")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_vhhgt")
text = "Sydney Harbour. They've strung energy beams across the water."

[sub_resource type="Resource" id="Resource_4ea1l"]
script = ExtResource("3_r2ovy")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_1a60w")
text = "Find the gap in each beam, or take out one of the emitters to drop it. Shield drones are covering their friends -- hit them when the shield flickers out."

[sub_resource type="Resource" id="Resource_rw23m"]
script = ExtResource("3_r2ovy")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_vhhgt")
text = "There's something big under the harbour. When it surfaces, make it count."

