[sub_resource type="Resource" id="Resource_6vbp7"]
script = ExtResource("3_baww8")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_noxgt")
text = "Pyramid's clear. Four and a half thousand years old, and it's still standing."

[sub_resource type="Resource" id="Resource_uk54f"]
script = ExtResource("3_baww8")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_pghqx")
text = "That ship was pumping water up from under the Nile. Whatever they want, it's in the water."

[sub_resource type="Resource" id="Resource_2a3js"]
script = ExtResource("3_baww8")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_y4wva")
text = "Cairo. Something's landed on the Great Pyramid, and it's dug itself in."

[sub_resource type="Resource" id="Resource_1iclh"]
script = ExtResource("3_baww8")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_pghqx")
text = "Sandstorms are whipping across the desert -- watch for the gust warnings and steer into the wind. Things are burrowing in the sand, too."

[sub_resource type="Resource" id="Resource_47qau"]
script = ExtResource("3_baww8")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_y4wva")
text = "Get to Giza and take that pyramid back."

