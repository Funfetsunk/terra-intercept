[sub_resource type="Resource" id="Resource_76xwp"]
script = ExtResource("3_jbjbf")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_ykacu")
text = "Relay's silent. Good work up there."

[sub_resource type="Resource" id="Resource_of7ec"]
script = ExtResource("3_jbjbf")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_skgxx")
text = "We traced the signal before it went dark. It wasn't calling home -- it was calling something much closer."

[sub_resource type="Resource" id="Resource_dt8xv"]
script = ExtResource("3_jbjbf")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_kf1yx")
text = "Everest. They've built something on the summit, and it's transmitting."

[sub_resource type="Resource" id="Resource_u7yq6"]
script = ExtResource("3_jbjbf")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_skgxx")
text = "The slopes are unstable -- when you see avalanche warnings, get out of the lane. The snow takes their ships too. And watch for mines and sniper lines."

[sub_resource type="Resource" id="Resource_ggkfx"]
script = ExtResource("3_jbjbf")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_kf1yx")
text = "Climb to the top and shut that relay down."

