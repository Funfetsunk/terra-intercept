[sub_resource type="Resource" id="Resource_g1hmy"]
script = ExtResource("3_fplns")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_fixit")
text = "The serpent's down. That Wall's stood two thousand years -- it can stand a bit longer."

[sub_resource type="Resource" id="Resource_qqpxq"]
script = ExtResource("3_fplns")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_81bwg")
text = "We're past the halfway mark. Whatever they're building, we're getting close to it."

[sub_resource type="Resource" id="Resource_p1mix"]
script = ExtResource("3_fplns")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_lrdo2")
text = "The Great Wall. They've taken it over and turned it into a highway for their armour."

[sub_resource type="Resource" id="Resource_quvv0"]
script = ExtResource("3_fplns")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_81bwg")
text = "Stay with the Wall -- it winds, so the ground will drift under you. Watch for tanks crawling along the top, and for sniper laser lines. When you see one, move."

[sub_resource type="Resource" id="Resource_ry4so"]
script = ExtResource("3_fplns")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_lrdo2")
text = "Something big is coiled up at the far end. Go and find it."

