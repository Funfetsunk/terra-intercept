[sub_resource type="Resource" id="Resource_gunw1"]
script = ExtResource("3_ki8av")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_m3e7o")
text = "Convoy's wrecked. That's one shipment they'll never get."

[sub_resource type="Resource" id="Resource_hmutt"]
script = ExtResource("3_ki8av")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_gmhdk")
text = "They want ice, water, whatever we've got. We need to find out why."

[sub_resource type="Resource" id="Resource_a0imi"]
script = ExtResource("3_ki8av")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_rnn56")
text = "Siberia. They're stripping the permafrost for ice and hauling it out by the trainload."

[sub_resource type="Resource" id="Resource_iwnl6"]
script = ExtResource("3_ki8av")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_gmhdk")
text = "Fog's rolling in thick out there -- keep out of the worst of it. And watch the ground: something's tunnelling under the ice."

[sub_resource type="Resource" id="Resource_8upg4"]
script = ExtResource("3_ki8av")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_rnn56")
text = "Find that convoy and stop it."

