[sub_resource type="Resource" id="Resource_2oxa6"]
script = ExtResource("3_xlay4")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_vun0b")
text = "The kaiju's down. Tokyo's seen its share of monsters -- that one won't be getting a sequel."

[sub_resource type="Resource" id="Resource_1va7t"]
script = ExtResource("3_xlay4")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_0kr2n")
text = "One more push and we're at their front door."

[sub_resource type="Resource" id="Resource_130p5"]
script = ExtResource("3_xlay4")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_cmrj8")
text = "Tokyo. They're hiding in plain sight -- in the neon."

[sub_resource type="Resource" id="Resource_rg8ij"]
script = ExtResource("3_xlay4")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_0kr2n")
text = "Their stealth fighters fade in and out of view, and the billboards will hide their fire. Watch for the shimmer. Shield drones are protecting their escorts -- wait for the shield to drop, then hit them."

[sub_resource type="Resource" id="Resource_qi8w1"]
script = ExtResource("3_xlay4")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_cmrj8")
text = "And something big is walking through Shinjuku. Stop it."

