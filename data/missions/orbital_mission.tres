[sub_resource type="Resource" id="Resource_lucvs"]
script = ExtResource("3_k4kal")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_6d15b")
text = "The mothership's gone and you're through the portal. I'm proud of every one of you."

[sub_resource type="Resource" id="Resource_p8cps"]
script = ExtResource("3_k4kal")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_gbuod")
text = "Now find the Gate Core and deliver that frequency. Bring everyone home."

[sub_resource type="Resource" id="Resource_a3ufj"]
script = ExtResource("3_k4kal")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_gbuod")
text = "This is it. Launch from Canaveral, punch through their fleet, and take the fight to the mothership guarding the portal."

[sub_resource type="Resource" id="Resource_cgh0v"]
script = ExtResource("3_k4kal")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_uhr04")
text = "Its hull is covered in gun turrets -- strip them and the core will be exposed. Their ships up here are tougher than anything you've seen."

[sub_resource type="Resource" id="Resource_gb28y"]
script = ExtResource("3_k4kal")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_gbuod")
text = "Destroy the core and dive through the portal. We end this on their world."

