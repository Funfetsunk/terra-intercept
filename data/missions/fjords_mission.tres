[sub_resource type="Resource" id="Resource_3unda"]
script = ExtResource("3_ctl80")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_6t65v")
text = "Drill's scrap. The glacier can keep its water."

[sub_resource type="Resource" id="Resource_w8o5m"]
script = ExtResource("3_ctl80")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_jff7m")
text = "Whatever they're harvesting, it starts with water. Stay sharp."

[sub_resource type="Resource" id="Resource_pywuy"]
script = ExtResource("3_ctl80")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_s36mw")
text = "Norway. They've cracked open a glacier at the head of a fjord, and they're drilling for the meltwater."

[sub_resource type="Resource" id="Resource_g0nlp"]
script = ExtResource("3_ctl80")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_jff7m")
text = "The fjord pinches tight in places -- stay off the cliffs. And watch for carriers. Kill them before they empty their bays."

[sub_resource type="Resource" id="Resource_tn6va"]
script = ExtResource("3_ctl80")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_s36mw")
text = "Fly up the fjord and stop that drill."

