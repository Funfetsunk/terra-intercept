[sub_resource type="Resource" id="Resource_6xopl"]
script = ExtResource("3_c10jw")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("2_x6bup")
text = "The crawler's scrap. That canyon took a few million years to carve -- they don't get to undo it."

[sub_resource type="Resource" id="Resource_4e2p3"]
script = ExtResource("3_c10jw")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_y6jmr")
text = "That's the last of their ground operations. Next stop: orbit."

[sub_resource type="Resource" id="Resource_mnavv"]
script = ExtResource("3_c10jw")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_e3fna")
text = "The Grand Canyon. They're strip-mining it from the bottom up."

[sub_resource type="Resource" id="Resource_lq4at"]
script = ExtResource("3_c10jw")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("4_y6jmr")
text = "The canyon zigzags hard and there are rock pillars standing in the channel -- weave, don't ram. New drones too: some dive straight at you, some split apart when you hit them."

[sub_resource type="Resource" id="Resource_tdekd"]
script = ExtResource("3_c10jw")
speaker_name = "Steel"
portrait_color = Color(0.85, 0.65, 0.25, 1)
portrait = ExtResource("5_e3fna")
text = "There's a mining machine chewing its way up the canyon. Stop it."

